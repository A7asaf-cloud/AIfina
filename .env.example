# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Required for Gemini AI API calls (OCR, advisor, stock insights)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted
APP_URL="MY_APP_URL"

# ── JWT Authentication ─────────────────────────────────────────────────────────
# Leave JWT_SECRET empty to run without JWT auth (network-trusted mode)
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')|console.log"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth (leave empty to disable Google login) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match exactly in Google Cloud Console → OAuth → Redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── SMTP / Email OTP (leave SMTP_HOST empty to print OTPs to server log) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# ── Frontend URL (used in Google OAuth callback redirect) ─────────────────────
FRONTEND_URL=http://localhost:3000
